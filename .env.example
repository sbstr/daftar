# Tax launch mode
# trial_no_tax keeps VAT at 0 until the organization adds a valid VAT number.
DEFAULT_LAUNCH_MODE=trial_no_tax

# Payments: keep sandbox until Moyasar activates your account.
# For real/test Moyasar invoice links use PAYMENT_PROVIDER=moyasar and a sk_test_/sk_live_ secret key.
PAYMENT_PROVIDER=sandbox
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# WhatsApp Cloud API
